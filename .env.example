# Required — set these before deploying
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# Your CBP-v2 Worker URL (after `wrangler deploy`)
VITE_WORKER_URL=https://cbp-v2.YOURNAME.workers.dev

# MUST match the SECRET set in the Worker via `wrangler secret put SECRET`
VITE_PROXY_SECRET=CHANGE_ME_SAME_AS_WORKER_SECRET
